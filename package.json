{
  "name": "reel-accidente-trenes-toledo",
  "version": "1.0.0",
  "private": true,
  "description": "Reel informativo (9:16, 3 minutos) sobre el choque de trenes del 28 de octubre de 2026 en Toledo, hecho con Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render Accidente out/accidente-trenes.mp4",
    "render:sin-subtitulos": "remotion render AccidenteSinSubtitulos out/accidente-trenes-sin-subtitulos.mp4",
    "portada": "remotion still Accidente out/portada.png --frame=150",
    "subtitulos": "node scripts/subtitulos.js",
    "typecheck": "tsc",
    "trigliceridos": "remotion render Trigliceridos out/trigliceridos.mp4",
    "trigliceridos:portada": "remotion still Trigliceridos out/trigliceridos-portada.png --frame=90",
    "colesterol": "remotion render Colesterol out/colesterol.mp4",
    "colesterol:portada": "remotion still Colesterol out/colesterol-portada.png --frame=100",
    "mitos": "remotion render TrigliceridosMitos out/trigliceridos-mitos.mp4",
    "mitos:portada": "remotion still TrigliceridosMitos out/trigliceridos-mitos-portada.png --frame=60",
    "anemia": "remotion render Anemia out/anemia.mp4",
    "anemia:portada": "remotion still Anemia out/anemia-portada.png --frame=100",
    "tdah": "remotion render Tdah out/tdah.mp4 --crf=24",
    "tdah:portada": "remotion still Tdah out/tdah-portada.png --frame=120",
    "tdah90": "remotion render Tdah90 out/tdah-90s.mp4 --crf=24",
    "hipertiroidismo": "remotion render Hipertiroidismo out/hipertiroidismo.mp4 --crf=24",
    "hipotiroidismo": "remotion render Hipotiroidismo out/hipotiroidismo.mp4 --crf=24",
    "arritmia": "remotion render Arritmia out/arritmia.mp4 --crf=24",
    "tenerife": "remotion render JesusDeMiguel out/jesus-de-miguel.mp4 --crf=24",
    "pies": "remotion render PiesHinchados out/pies-hinchados.mp4 --crf=24",
    "presion": "remotion render PresionArterial out/presion-arterial.mp4 --crf=24",
    "ansiedad": "remotion render Ansiedad out/ansiedad.mp4 --crf=24"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "^4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
