{
  "name": "reel-historia-computadora",
  "version": "1.0.0",
  "private": true,
  "description": "Reel de Instagram (9:16) sobre la historia de la computadora, hecho con Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render HistoriaComputadora out/historia-computadora.mp4",
    "still": "remotion still HistoriaComputadora out/portada.png --frame=45",
    "titanic": "remotion render Titanic out/titanic.mp4",
    "titanic:sin-subtitulos": "remotion render TitanicSinSubtitulos out/titanic-sin-subtitulos.mp4",
    "subtitulos": "node scripts/subtitulos.js"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
